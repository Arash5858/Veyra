#!/usr/bin/env python3

import json
import sys
import time
import urllib.request
import urllib.error
from concurrent.futures import ThreadPoolExecutor, as_completed


TIMEOUT = 5


def load_endpoints(path):
    with open(path, "r", encoding="utf-8") as file:
        data = json.load(file)

    if not isinstance(data, list):
        raise ValueError("endpoints.json must contain a list.")

    return data


def check_endpoint(endpoint):
    name = endpoint.get("name", "Unnamed")
    url = endpoint.get("url")

    if not url:
        return {
            "name": name,
            "url": "",
            "status": "ERROR",
            "code": "-",
            "latency": "-"
        }

    start = time.perf_counter()

    try:
        request = urllib.request.Request(
            url,
            headers={"User-Agent": "Veyra/1.0"}
        )

        with urllib.request.urlopen(request, timeout=TIMEOUT) as response:
            latency = round((time.perf_counter() - start) * 1000)

            return {
                "name": name,
                "url": url,
                "status": "UP",
                "code": response.status,
                "latency": f"{latency} ms"
            }

    except urllib.error.HTTPError as error:
        latency = round((time.perf_counter() - start) * 1000)

        return {
            "name": name,
            "url": url,
            "status": "DOWN",
            "code": error.code,
            "latency": f"{latency} ms"
        }

    except Exception:
        return {
            "name": name,
            "url": url,
            "status": "DOWN",
            "code": "-",
            "latency": "-"
        }


def print_results(results):
    print("\nVEYRA — Endpoint Health Monitor")
    print("-" * 72)

    for result in results:
        print(
            f"{result['name']:<20}"
            f"{result['status']:<10}"
            f"{str(result['code']):<8}"
            f"{result['latency']:<12}"
            f"{result['url']}"
        )

    print("-" * 72)

    total = len(results)
    healthy = sum(1 for item in results if item["status"] == "UP")

    print(f"Health: {healthy}/{total} endpoints operational")


def main():
    path = sys.argv[1] if len(sys.argv) > 1 else "endpoints.json"

    try:
        endpoints = load_endpoints(path)
    except (FileNotFoundError, json.JSONDecodeError, ValueError) as error:
        print(f"Configuration error: {error}")
        sys.exit(1)

    results = []

    with ThreadPoolExecutor(max_workers=10) as executor:
        futures = [
            executor.submit(check_endpoint, endpoint)
            for endpoint in endpoints
        ]

        for future in as_completed(futures):
            results.append(future.result())

    results.sort(key=lambda item: item["name"].lower())

    print_results(results)


if __name__ == "__main__":
    main()
